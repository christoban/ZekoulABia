# Copier ce fichier vers `.env` et remplir les valeurs réelles. Ne jamais commiter `.env` ni `.env.*`.
DATABASE_URL=
INNGEST_DEV=1
MASTER_BOOTSTRAP_EMAIL=
MASTER_BOOTSTRAP_PASSWORD=

# ==============================================================================
# CONFIGURATION DES URLS DE LA PLATEFORME (12-Factor App)
# ==============================================================================
# FRONTEND_URL : URL publique racine du frontend web (SaaS)
# En local : "http://localhost:3000"
# En production : "https://zekoulabia.chri.app"
FRONTEND_URL="http://localhost:3000"

# PUBLIC_VERIFY_BASE_URL : Base URL encodée dans les QR codes de vérification des bulletins
# Si absent, repli sur FRONTEND_URL -> CLIENT_URL -> APP_URL -> http://localhost:3000
PUBLIC_VERIFY_BASE_URL="http://localhost:3000"

# TRUST_PROXY : Indispensable derrière un reverse proxy (Railway / Cloudflare / Nginx)
# pour lire la véritable IP client dans le rate limiter (/verify, auth, etc.).
# Activé automatiquement si RAILWAY_ENVIRONMENT est présent ; forcer à "1" sinon.
# TRUST_PROXY="1"

# MASTER_SECRET_PATH : Chemin secret d'accès au portail Master Hub (partagé avec frontend/src/proxy.ts)
# Par défaut : "/master-secret-entry"
MASTER_SECRET_PATH="/master-secret-entry"

# MASTER_ENTRY_URL : (Optionnel) Pour forcer une URL absolue complète pour le portail Master
# MASTER_ENTRY_URL="https://zekoulabia.chri.app/master-secret-entry"

# CLIENT_URL : Conservé pour rétrocompatibilité (synonyme de FRONTEND_URL)
# CLIENT_URL="http://localhost:3000"

# ==============================================================================
# STOCKAGE DE FICHIERS UNIFIÉ (FileStoragePort — unique port de stockage)
# Couvre : pièces jointes, photos élèves, kit d'identité, bulletins PDF scellés,
# déclarations MINESEC/MINEDUB et sauvegardes JSON d'établissement.
# Voir docs/STOCKAGE_FICHIERS.md pour la checklist VPS et les sauvegardes.
# ==============================================================================
# Driver : "local" (défaut dev/test ou VPS avec volume persistant) ou "s3" (S3/R2/MinIO/Scaleway)
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_LOCAL_DIR="./storage/files"
# Mettre à "true" uniquement si FILE_STORAGE_LOCAL_DIR pointe sur un volume disque persistant en prod (ex. VPS)
FILE_STORAGE_PERSISTENT_VOLUME="false"
#
# Variables S3-compatibles (requises si FILE_STORAGE_DRIVER="s3") :
# FILE_STORAGE_S3_BUCKET=""
# FILE_STORAGE_S3_ENDPOINT=""
# FILE_STORAGE_S3_REGION="auto"
# FILE_STORAGE_S3_ACCESS_KEY_ID=""
# FILE_STORAGE_S3_SECRET_ACCESS_KEY=""
# FILE_STORAGE_S3_PREFIX=""
# FILE_STORAGE_S3_FORCE_PATH_STYLE="false"

# ==============================================================================
# FEATURE FLAGS (désactivés par défaut)
# ==============================================================================
# Matérialisation des programmes officiels nationaux vers les écoles (Lots 1 à 3)
ENABLE_OFFICIAL_PROGRAMMES_MATERIALISATION="false"
# Liste optionnelle d'identifiants d'écoles pilotes séparés par des virgules.
# Vide = toutes les écoles lorsque ENABLE_OFFICIAL_PROGRAMMES_MATERIALISATION="true".
# Renseignée = seules ces écoles ont accès ; les autres se comportent comme flag éteint.
OFFICIAL_PROGRAMMES_PILOT_SCHOOL_IDS=""

