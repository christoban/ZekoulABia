// Statut de provisionnement d'une classe pour son année scolaire :
// DRAFT  : proposée automatiquement par CloturerAnneeUseCase (clonée des classes actives de
//          l'année qui se termine), en attente de revue/ajustement par l'admin — jamais utilisée
//          ailleurs dans le système tant qu'elle n'est pas validée.
// ACTIVE : classe confirmée, utilisable normalement (affectations, notes, emploi du temps...).
enum ClassStatus {
  DRAFT
  ACTIVE
}

model Class {
  id                    String                 @id @default(cuid())
  schoolId              String
  academicYearId        String
  status                ClassStatus            @default(ACTIVE)
  name                  String
  level                 String?
  sectionId             String?
  capacity              Int                    @default(40)
  createdAt             DateTime               @default(now())
  deletedAt             DateTime?
  deletedById           String?
  filiere               String?
  pebsMixte             Boolean                @default(false)
  serie                 String?
  professorPrincipalId  String?                @unique
  attendances           Attendance[]
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear          AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section               Section?               @relation(fields: [sectionId], references: [id])
  professorPrincipal    User?                  @relation("ClassProfessorPrincipal", fields: [professorPrincipalId], references: [id])
  classCouncilSessions  ClassCouncilSession[]
  bulletinValidationSessions BulletinValidationSession[]
  subGroups             ClassSubGroup[]
  exams                 Exam[]
  grades                Grade[]
  timetables            Timetable[]
  studentFromPromotions StudentPromotion[]     @relation("StudentFromClass")
  studentToPromotions   StudentPromotion[]     @relation("StudentToClass")
  fromPromotions        ClassPromotion[]       @relation("FromClass")
  toPromotions          ClassPromotion[]       @relation("ToClass")
  teachingAssignments   TeachingAssignment[]
  subjectOverrides      ClassSubjectOverride[]
  programmes            Programme[]
  cahierDeTexte         CahierDeTexte[]
  studentOnboardings    StudentOnboarding[]
  roomAssignments       ClassRoomAssignment[]
   enrollments           Enrollment[]
  assessmentSessions    HarmonizedAssessmentSession[]
  anonymatCodes         AnonymatCode[]

  @@index([schoolId])
  @@index([deletedAt])
  @@index([academicYearId])
  @@index([schoolId, academicYearId])
}

model Subject {
  id                     String                  @id @default(cuid())
  schoolId               String
  name                   String
  code                   String?
  coefficient            Float                   @default(1)
  hoursPerWeek           Int                     @default(2)
  // V2.5 — séances groupées en blocs de N cases adjacentes (null/1 = libre, 2 = blocs de 2 h).
  blocDureeCases         Int?
  createdAt              DateTime                @default(now())
  deletedAt              DateTime?
  deletedById            String?
  subjectType            SubjectType             @default(THEORETICAL)
  departmentId           String?
  isLV2                  Boolean                 @default(false)
  // Matière réservée aux membres d'un StudentGroup précis (ex. "English Literature" → Group
  // "Bilingue" du GroupSet "Programme") — les élèves hors de ce Group n'ont simplement pas de
  // séance, pas d'erreur. Distinct du fan-out par GroupSet entier (LV2), piloté par
  // GenererSeancesGroupeUseCase, pas par un champ ici.
  restrictedToGroupId    String?
  restrictedToGroup      StudentGroup?           @relation("SubjectRestrictedToGroup", fields: [restrictedToGroupId], references: [id])
  exams                  Exam[]
  grades                 Grade[]
  attendances            Attendance[]
  reportCardSubjectLines ReportCardSubjectLine[]
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectCoefficients    SubjectCoefficient[]
  classSubjectOverrides  ClassSubjectOverride[]
  teacherSubjects        TeacherSubject[]
  timetableSlots         TimetableSlot[]
  assessmentSessions     HarmonizedAssessmentSession[]
  teachingAssignments    TeachingAssignment[]
  department             Department?             @relation(fields: [departmentId], references: [id])
  programmes             Programme[]
  cahierDeTexte          CahierDeTexte[]
  lv2Students            StudentProfile[]        @relation("StudentLV2")
  alevelStudents         StudentALevelSubject[]  @relation("SubjectALevelStudents")
  lv2ChoiceSubmissions   Lv2ChoiceSubmission[]
  followUpActions        StudentFollowUpAction[]
  studentGroups          StudentGroup[]

  @@index([schoolId])
  @@index([deletedAt])
}

model Department {
  id       String  @id @default(cuid())
  schoolId String
  name     String
  color    String  @default("#6b7280")
  headId   String? @unique

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  head     User?     @relation("DepartmentHead", fields: [headId], references: [id])
  subjects Subject[]
  teachers TeacherDepartment[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model TeacherSubject {
  teacherProfileId String
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id])
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@id([teacherProfileId, subjectId])
}

model TeacherDepartment {
  teacherProfileId String
  departmentId     String
  department       Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teacherProfile   TeacherProfile  @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, departmentId])
}

model TeachingAssignment {
  id             String @id @default(cuid())
  classId        String
  subjectId      String
  teacherId      String
  schoolId       String
  // Explicitement redondant avec classId → Class.academicYearId : conservé pour la clarté des
  // requêtes (filtrer par année sans jointure) et la résilience si le rôle de classId évolue.
  academicYearId String

  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      User         @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@index([academicYearId])
}

// V2.4 — Indisponibilité enseignant (récurrente hebdomadaire). L'absence d'enregistrement
// signifie disponible (repli sûr) — on ne stocke que les exceptions. La grille EDT étant
// hebdomadaire sans date fixe, la récurrence par jour-de-semaine + plage horaire est le bon
// grain. Scoping tenant par colonne directe schoolId (même convention que DisciplineRecord,
// Attendance, Grade). Limitation assumée : ne s'applique qu'aux futures propositions du
// solveur, jamais rétroactivement aux emplois du temps déjà appliqués.
model TeacherUnavailability {
  id         String   @id @default(cuid())
  schoolId   String
  teacherId  String
  dayOfWeek  Int // 0=lundi … 5=samedi (convention unifiée joursSemaine, jamais filtrer par falsy)
  startTime  String   // "HH:MM"
  endTime    String   // "HH:MM"
  reason     String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  teacher User   @relation("TeacherUnavailabilities", fields: [teacherId], references: [id], onDelete: Cascade)
  school  School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, teacherId])
  @@index([schoolId, active])
  @@index([teacherId, dayOfWeek])
}

model Attendance {
  id               String           @id @default(cuid())
  schoolId         String
  studentId        String
  classId          String
  academicPeriodId String?
  date             DateTime
  status           AttendanceStatus @default(PRESENT)
  period           AttendancePeriod @default(MORNING)
  recordedById     String?
  subjectId        String?
  teacherId        String?
  justification    String?
  justifiedById    String?
  justifiedAt      DateTime?
  isOfflineSync    Boolean          @default(false)
  syncedAt         DateTime?
  createdAt        DateTime         @default(now())
  academicPeriod   AcademicPeriod?  @relation(fields: [academicPeriodId], references: [id])
  class            Class            @relation(fields: [classId], references: [id])
  recordedBy       User?            @relation("RecordedAttendances", fields: [recordedById], references: [id])
  justifiedBy      User?            @relation("JustifiedAttendances", fields: [justifiedById], references: [id])
  subject          Subject?         @relation(fields: [subjectId], references: [id])
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          User             @relation("StudentAttendances", fields: [studentId], references: [id])
  teacher          User?            @relation("TeacherAttendances", fields: [teacherId], references: [id])

  @@index([schoolId, classId, date])
  @@index([schoolId, studentId])
}

model Grade {
  id                   String                @id @default(cuid())
  schoolId             String
  studentId            String
  subjectId            String
  classId              String
  academicYearId       String
  sequenceId           String
  sequenceScore        Float?
  classTestScore       Float?
  terminalExamScore    Float?
  theoreticalScore     Float?
  practicalScore       Float?
  professionalAttitude Float?
  oralScore            Float? // Score oral — primaire APC (composante Oral)
  selfDevelopmentScore Float? // Savoir-être — primaire APC (composante Savoir-être)
  coefficient          Float                 @default(1)
  maxValue             Float                 @default(20)
  sequenceAverage      Float?
  validationStatus     GradeValidationStatus @default(DRAFT)
  validatedById        String?
  validatedAt          DateTime?
  rejectionReason      String?
  observation          String?
  isOfflineSync        Boolean               @default(false)
  syncedAt             DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  recordedById         String?
  academicYear         AcademicYear          @relation(fields: [academicYearId], references: [id])
  class                Class                 @relation(fields: [classId], references: [id])
