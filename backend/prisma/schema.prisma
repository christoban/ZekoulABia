model Expense {
  id          String   @id @default(cuid())
  schoolId    String
  label       String
  amount      Float
  currency    String   @default("XAF")
  category    String?
  date        DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("CreatedExpenses", fields: [createdById], references: [id])
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

enum APEETransactionType {
  COLLECTE
  DEPENSE
}

/**
 * Registre de transparence financière APEE (MODULE 7/11, chantier Juillet 2026) — distinct
 * du modèle Expense générique ci-dessus (dépenses courantes de l'établissement, sans workflow
 * de justificatif). Une DEPENSE exige un justificatif joint avant d'être marquée validée
 * (voir ValiderDepenseAPEEUseCase) ; une COLLECTE est considérée valide dès sa saisie par
 * l'intendant (montant reçu, pas de justificatif à produire).
 */
model APEETransaction {
  id              String              @id @default(cuid())
  schoolId        String
  type            APEETransactionType
  montant         Float
  categorie       String?
  description     String?
  date            DateTime            @default(now())
  justificatifUrl String?
  valide          Boolean             @default(false)
  valideParId     String?
  valideAt        DateTime?
  creeParId       String
  createdAt       DateTime            @default(now())
  school          School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creePar         User                @relation("APEETransactionCreatedBy", fields: [creeParId], references: [id])
  validePar       User?               @relation("APEETransactionValidatedBy", fields: [valideParId], references: [id])

  @@index([schoolId, type])
  @@index([schoolId, valide])
}

