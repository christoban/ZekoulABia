/// Journal des actions exécutées par l'assistant IA (copilot) dans l'interface.
/// Permet la confirmation des actions destructives et l'annulation (undo) des
/// actions non-destructives dans une fenêtre de temps limitée.
model AssistantActionLog {
  id          String    @id @default(uuid())
  schoolId    String
  userId      String
  actionType  String
  parameters  Json
  destructive Boolean   @default(false)
  status      String    @default("EXECUTED") // EXECUTED | UNDONE | PENDING_CONFIRMATION
  undoable    Boolean   @default(true)
  undoData    Json? // snapshot nécessaire à l'annulation (ex. ancien prof principal)
  resultLabel String? // résumé lisible affiché dans le chat
  executedAt  DateTime  @default(now())
  undoneAt    DateTime?

  @@index([schoolId])
  @@index([userId])
  @@index([status])
}

/// Base de connaissances d'aide contextuelle pour le copilot Admin — contenu
/// plateforme (pas de schoolId : valable pour tous les établissements), indexé
/// par écran (screenKey, ex. "admin.grades") pour que l'assistant fonde ses
/// réponses dessus plutôt que d'inventer une explication.
model HelpArticle {
  id               String   @id @default(uuid())
  screenKey        String // ex. "admin.grades", "admin.lv2-choice"
  title            String
  content          String // texte explicatif structuré, injecté dans le prompt système
  relatedSelectors Json? // liste de sélecteurs data-help-id à surligner si mentionnés
  role             String[] // rôles concernés (ex. ["ADMIN"])
  locale           String // "fr" | "en"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([screenKey, locale])
}

/// Journal des questions d'aide posées au copilot — analytique produit (quels
/// écrans génèrent le plus de confusion), pas de donnée personnelle structurée
/// stockée (le texte libre de la question peut occasionnellement mentionner un
/// nom d'élève, accepté pour ce premier jet — voir plan de la fonctionnalité).
model AssistantHelpQueryLog {
  id           String   @id @default(uuid())
  schoolId     String
  userId       String
  role         String
  screenKey    String?
  question     String
  responseType String // MESSAGE | ACTION | ESCALATE
  articleFound Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([schoolId])
  @@index([screenKey])
  @@index([createdAt])
}

/// Historique persistant des échanges du copilot, par fil de conversation.
/// Prérequis découvert en Section 1 du chantier "Copilot Unifié" : sans mémoire
/// des tours précédents, l'assistant ne peut pas exploiter une réponse de
/// clarification de l'utilisateur (Principe 4 — jamais d'action sur une
/// supposition). Même principe que le fix déjà validé pour l'onboarding PEBS
/// conversationnel (historique sérialisé en texte, cumulé tour par tour), mais
/// persisté côté serveur par `conversationId` plutôt que gardé en state client
/// éphémère — permet de résister à une reconnexion réseau ou à une re-render.
model AssistantConversationTurn {
  id             String   @id @default(uuid())
  conversationId String
  schoolId       String
  userId         String
  role           String // "user" | "assistant"
  content        String // texte du message, ou réponse + résumé des actions exécutées/en attente
  toolCalls      Json? // appels de fonction éventuels de ce tour (nom + input), pour mémoire
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([schoolId, userId])
}

/// Origine réelle d'une action journalisée — vient de la route HTTP classique, ou d'un tool-call
/// choisi par le copilot IA. Ne change jamais la source d'autorisation (toujours la session
/// serveur, voir AssistantController) : sert uniquement à distinguer les deux dans le journal.
enum AIActionOrigin {
  UI_DIRECT
  AI_ASSISTANT
}

enum AIActionOutcome {
  SUCCES
  REFUSE
  ERREUR
}

/// Journal d'audit des actions sensibles (règle métier / RBAC / cible), UI classique et copilot
/// IA confondus — chantier "Sécurité de l'assistant IA". Écrit à CHAQUE exécution, réussie ou
/// refusée, jamais seulement pour l'assistant : un admin qui contourne une règle métier via
/// l'écran classique doit être aussi traçable qu'une tentative via le copilot. `triggeringMessage`
/// contient potentiellement du contenu personnel — mêmes principes de protection/rétention que le
/// reste des données personnelles du projet, pas un journal technique exempté des règles
/// habituelles.
model AIActionAuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())

  actorUserId String // identité réelle de la session authentifiée, jamais déduite de la conversation
  actorRole   String // rôle réel au moment de l'action
  schoolId    String? // établissement concerné, pour le scoping de la vue admin d'établissement

  actionName String // nom de l'action/outil du catalogue, ou de la route HTTP classique
  targetType String? // type de la cible (ex. "StudentProfile", "User")
  targetId   String? // identifiant de la cible

  origin        AIActionOrigin
  outcome       AIActionOutcome
  refusalReason String? // ex. "role_insuffisant", "hors_perimetre_classe", "cible_hors_perimetre"

  parametersSummary Json? // paramètres sanitisés — jamais de mot de passe/secret en clair, même refusé
  triggeringMessage String? // pour origin=AI_ASSISTANT uniquement : message ayant déclenché l'appel

  @@index([actorUserId, timestamp])
  @@index([schoolId, timestamp])
  @@index([outcome, timestamp])
}

/// Trace des alertes déjà envoyées à l'opérateur plateforme pour un pattern de refus répétés
/// (section 5 du chantier) — sert UNIQUEMENT à éviter de ré-alerter en boucle tant qu'un même
/// utilisateur reste dans la fenêtre glissante de 10 minutes ; le détail des refus reste dans
/// AIActionAuditLog, cette table ne duplique rien.
model AISecurityAlert {
  id          String   @id @default(cuid())
  actorUserId String
  actorRole   String
  schoolId    String?
  refuseCount Int
  notifiedAt  DateTime @default(now())

  @@index([actorUserId, notifiedAt])
}

/// Idempotence des requêtes rejouées par la file de synchronisation offline (Plan
/// offline-first V1 §4, pattern Outbox) — `key` est l'UUID v4 généré côté client à la
/// création de l'action en attente (`PendingAction.idempotencyKey`, frontend). Une entrée
/// n'est enregistrée qu'après un traitement RÉUSSI (2xx) : un échec ne "empoisonne" jamais
/// la clé, une vraie retentative doit pouvoir réessayer normalement. `responseBody`/
/// `statusCode` permettent de rejouer exactement la même réponse au client si la même clé
/// revient (synchronisation interrompue puis retentée) sans ré-exécuter l'action.
model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @unique
  userId       String
  method       String
  path         String
  statusCode   Int
  responseBody Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

