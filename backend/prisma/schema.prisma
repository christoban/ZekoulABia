// Registre administratif périphérique MINESEC (dossiers d'examen, paiements officiels) —
// PAS la source de vérité classe/élève de l'année en cours (voir StudentProfile.classId et
// Class.academicYearId pour ça). anneeScolaire/classe restent volontairement des champs texte
// libres : ce modèle n'a pas vocation à être absorbé dans le nouveau modèle year-scoped, décision
// actée (renommé depuis "Enrollment" pour lever l'ambiguïté).
model InscriptionMinesec {
  id             String                   @id @default(cuid())
  studentId      String
  schoolId       String
  anneeScolaire  String
  classe         String
  status         InscriptionMinesecStatus @default(ACTIVE)
  transferOrigin String?
  transferDate   DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  student          StudentProfile          @relation(fields: [studentId], references: [id])
  school           School                  @relation(fields: [schoolId], references: [id])
  paiementsMinesec PaiementMinesec[]
  paiementsEtab    PaiementEtablissement[]

  @@unique([studentId, schoolId, anneeScolaire])
  @@index([schoolId, anneeScolaire])
  @@index([status])
}

enum InscriptionMinesecStatus {
  ACTIVE
  SUSPENDED
  TRANSFERRED_OUT
  TRANSFERRED_IN
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  DROPPED
  REPEATING
}

model Enrollment {
  id              String            @id @default(cuid())
  studentId       String
  classId         String
  academicYearId  String
  schoolId        String
  status          EnrollmentStatus  @default(ACTIVE)
  enrolledAt      DateTime          @default(now())
  enrolledById    String
  exitedAt        DateTime?
  exitReason      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  student         StudentProfile    @relation(fields: [studentId], references: [id])
  class           Class             @relation(fields: [classId], references: [id])
  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id])
  school          School            @relation(fields: [schoolId], references: [id])
  enrolledBy      User              @relation("EnrollmentBy", fields: [enrolledById], references: [id])

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId])
  @@index([classId])
  @@index([studentId])
}

model PaiementMinesec {
  id             String                @id @default(cuid())
  studentId      String
  enrollmentId   String
  schoolId       String
  anneeScolaire  String
  typeFrais      TypeFraisMinesec
  montantAttendu Float
  montantPaye    Float?
  operateur      OperateurMinesec?
  numeroRecu     String?
  recuVerifie    Boolean               @default(false)
  recuVerifieAt  DateTime?
  status         PaiementMinesecStatus @default(IMPAYE)
  dateEcheance   DateTime?
  datePaiement   DateTime?
  dataSource     DataSource            @default(MANUAL)
  notes          String?

  student    StudentProfile     @relation(fields: [studentId], references: [id])
  enrollment InscriptionMinesec @relation(fields: [enrollmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, anneeScolaire])
  @@index([schoolId, status])
  @@index([typeFrais, status])
}

enum TypeFraisMinesec {
  SCOLARITE_PREMIER_CYCLE
  SCOLARITE_SECOND_CYCLE
  EXAMEN_BEPC
  EXAMEN_PROBATOIRE
  EXAMEN_BAC
  EXAMEN_GCE_OL
  EXAMEN_GCE_AL
}

enum OperateurMinesec {
  MTN_MOMO
  ORANGE_MONEY
  CAMPOST
  EXPRESS_UNION
  AFRILAND
}

enum PaiementMinesecStatus {
  IMPAYE
  PAYE
  VERIFIE
  LITIGE
}

enum DataSource {
  MANUAL
  EXCEL_IMPORT
  SCRAPE_AUTO
  SYNC_NIGHTLY
}

model PaiementEtablissement {
  id                   String             @id @default(cuid())
