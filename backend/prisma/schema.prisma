  schoolId            String
  invoiceId           String?
  studentId           String
  amount              Float
  currency            String         @default("XAF")
  method              PaymentMethod  @default(CASH)
  status              PaymentStatus  @default(PENDING)
  transactionId       String?
  receiptUrl          String?
  paidAt              DateTime?
  feeType             FeeType        @default(TUITION)
  cautionStatus       CautionStatus?
  createdAt           DateTime       @default(now())
  refundTransactionId String?
  refundedAt          DateTime?
  refundedById        String?
  campayRef           String?
  campayStatus        String?
  operatorRef         String?
  phoneNumber         String?
  webhookData         Json?
  updatedAt           DateTime       @updatedAt
  refundedBy          User?          @relation("RefundedPayments", fields: [refundedById], references: [id])
  invoice             Invoice?       @relation(fields: [invoiceId], references: [id])
