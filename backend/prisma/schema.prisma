/// Dimension de subdivision des élèves (ex. "LV2", "Programme", "Sport") — un élève a au plus
/// un StudentGroup par StudentGroupSet (exclusivité imposée par StudentGroupMembership), mais
/// peut combiner des Groups de StudentGroupSet différents sans conflit. Nommé "Student..." pour
/// éviter toute confusion avec SchoolGroup (groupe multi-établissements, concept sans rapport).
model StudentGroupSet {
  id        String         @id @default(cuid())
  schoolId  String
  code      String
  name      String
  createdAt DateTime       @default(now())
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  groups    StudentGroup[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

/// Valeur dans une dimension (ex. "Allemand" dans le StudentGroupSet "LV2").
model StudentGroup {
  id                 String                   @id @default(cuid())
  groupSetId         String
  name               String
  // Matière réelle correspondante pour un Group de type "choix de matière" (LV2 : Group
  // "Allemand" → Subject Allemand) — optionnel, sans objet pour un GroupSet comme "Sport".
  subjectId          String?
  createdAt          DateTime                 @default(now())
  groupSet           StudentGroupSet          @relation(fields: [groupSetId], references: [id], onDelete: Cascade)
  subject            Subject?                 @relation(fields: [subjectId], references: [id])
  memberships        StudentGroupMembership[]
  restrictedSubjects Subject[]                @relation("SubjectRestrictedToGroup")
  timetableSlots     TimetableSlot[]

  @@unique([groupSetId, name])
  @@index([subjectId])
}

/// Jamais Student → Group direct — toujours via cette table. academicYearId scope
/// l'appartenance à une année (un élève change de Group LV2 d'une année à l'autre sans
/// réécrire d'historique).
model StudentGroupMembership {
  id               String         @id @default(cuid())
  studentProfileId String
  groupId          String
  // Dénormalisé depuis group.groupSetId : permet à la contrainte d'unicité ci-dessous d'imposer
  // "au plus 1 Group par GroupSet par élève par année" directement en base.
  groupSetId       String
  academicYearId   String
  createdAt        DateTime       @default(now())
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  group            StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, groupSetId, academicYearId])
  @@index([groupId])
}

/// Salle habituelle d'une classe pour l'année — valeur par défaut simple, fixe, PAS recalculée
/// à chaque génération d'emploi du temps. Changement en cours d'année possible mais manuel.
model ClassRoomAssignment {
  id             String       @id @default(cuid())
  schoolId       String
  classId        String
  roomId         String
  academicYearId String
  createdAt      DateTime     @default(now())
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  room           Room         @relation(fields: [roomId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([classId, academicYearId])
  @@index([schoolId])
  @@index([roomId])
}

model TimetableSlot {
  id             String         @id @default(cuid())
  timetableId    String
  subjectId      String?
  teacherId      String?
  dayOfWeek      Int
  startTime      String
  endTime        String
  roomId         String?
  kind           SlotKind       @default(CLASS)
  subGroupId     String?
  isLV2Slot      Boolean        @default(false)
  isElectiveSlot Boolean        @default(false)
  // StudentGroup (StudentGroupSet générique — LV2/Programme/...), distinct de subGroupId
  // (ClassSubGroup — sous-groupes TP ad hoc par classe, non touché). Posé par
  // GenererSeancesGroupeUseCase lors du fan-out d'une matière liée à un GroupSet.
  groupId        String?
  room           Room?          @relation(fields: [roomId], references: [id])
  subGroup       ClassSubGroup? @relation(fields: [subGroupId], references: [id])
  group          StudentGroup?  @relation(fields: [groupId], references: [id])
  subject        Subject?       @relation(fields: [subjectId], references: [id])
  teacher        User?          @relation("TeacherSlots", fields: [teacherId], references: [id])
  timetable      Timetable      @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  staffAttendances StaffAttendance[]
}

model FeePlan {
  id             String        @id @default(cuid())
  schoolId       String
  sectionId      String?
  name           String
  amount         Float
  currency       String        @default("XAF")
  description    String?
  createdAt      DateTime      @default(now())
  feeType        FeeType       @default(TUITION)
  level          String?
  isRefundable   Boolean       @default(false)
  dueDate        DateTime?
  // Nullable : les plans créés avant ce champ (ou via la création manuelle standard) restent
  // "évergreens", non rattachés à une année précise. Seule la reconduction automatique
  // (CopierPlansFraisAnneePrecedenteUseCase) rattache les plans copiés à l'année cible.
  academicYearId String?
  // Workflow de publication des frais (V1.11) : DRAFT → PENDING_VALIDATION → APPROVED → PUBLISHED.
  // Seuls les plans PUBLISHED peuvent générer des factures. Default PUBLISHED = les plans
  // existants (créés avant ce champ) restent facturables — zéro régression.
  status         FeePlanStatus @default(PUBLISHED)
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section        Section?      @relation(fields: [sectionId], references: [id])
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  invoices       Invoice[]

  @@index([schoolId, academicYearId])
}

model Invoice {
  id          String        @id @default(cuid())
  schoolId    String
  studentId   String
  feePlanId   String?
  amount      Float
  currency    String        @default("XAF")
  dueDate     DateTime?
  status      InvoiceStatus @default(PENDING)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  feePlan     FeePlan?      @relation(fields: [feePlanId], references: [id])
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     User          @relation("StudentInvoices", fields: [studentId], references: [id])
  payments    Payment[]

  @@index([schoolId, studentId])
}

model Payment {
