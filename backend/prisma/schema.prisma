  teachingAssignments             TeachingAssignment[]       @relation("TeacherAssignments")
  teacherUnavailabilities         TeacherUnavailability[]    @relation("TeacherUnavailabilities")
  headedDepartments               Department[]               @relation("DepartmentHead")
  cahierDeTexte                   CahierDeTexte[]            @relation("TeacherCahierDeTexte")
  employeeFile                    EmployeeFile?              @relation("EmployeeFileUser")
  employeeCareerEvents            CareerEvent[]              @relation("EmployeeCareerEvents")
  staffAttendances                StaffAttendance[]          @relation("StaffAttendanceUser")
  employeeLeaveRequests           LeaveRequest[]             @relation("EmployeeLeaveRequests")
  leaveRequestsValidated          LeaveRequest[]             @relation("LeaveRequestValidator")
  employeeLeaveBalances           LeaveBalance[]             @relation("EmployeeLeaveBalance")
  employeeMissionOrders           MissionOrder[]             @relation("EmployeeMissionOrders")
  onboardingsValidated            StudentOnboarding[]
  statisticalSubmissionsGenerated StatisticalSubmission[]
  minedubReportsGenerated         MinedubStatisticalReport[] @relation("MinedubReportGeneratedBy")
  apeeTransactionsCreated         APEETransaction[]          @relation("APEETransactionCreatedBy")
  apeeTransactionsValidated       APEETransaction[]          @relation("APEETransactionValidatedBy")
  disciplineCouncilSessions       DisciplineCouncilSession[] @relation("DisciplineCouncilStudent")
