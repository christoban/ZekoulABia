/// Archive définitive d'un compte "personne réelle" (élève/parent/enseignant/staff) purgé de la
/// corbeille après le délai de grâce — Couche 1 §1.4 du plan de sauvegarde. JAMAIS de vrai DELETE
/// sur une personne identifiable : la ligne User active est réellement supprimée par le job de
/// purge SEULEMENT après avoir été capturée ici (snapshot JSON — compte + profils + notes/
/// présences/bulletins liés au moment de l'archivage), pour deux raisons combinées : obligations
/// de conservation de dossiers scolaires sur plusieurs années, et capacité à répondre à une future
/// demande légale d'accès/effacement. Rétention volontairement longue par défaut, aucune purge
/// automatique programmée de cette table (voir définition de done du plan) — à confirmer un jour
/// auprès du MINESEC ou d'un juriste, mais le coût de stockage de lignes archivées est négligeable.
model UserArchive {
  id             String   @id @default(cuid())
  originalUserId String   @unique
  schoolId       String
  role           UserRole
  firstName      String
  lastName       String
  email          String?
  phone          String?
  snapshot       Json
  deletedAt      DateTime
  deletedById    String?
  archivedAt     DateTime @default(now())

  @@index([schoolId])
}

model StudentProfile {
  id                  String                      @id @default(cuid())
  userId              String                      @unique
  matricule           String?
  matriculeVerifieAt  DateTime?
  matriculeSource     MatriculeSource             @default(MANUAL)
  // Confiance de la correspondance nom/prénom ayant mené à l'association du matricule :
  // 'EXACT' (auto), 'FUZZY_CONFIRMED' (approximatif confirmé par l'admin), 'MANUAL' (saisie directe).
  // Distinct de matriculeSource, qui décrit le CANAL (import/scraping), pas la confiance du matching.
  matriculeMatchType  String?
  dateOfBirth         DateTime?
  gender              String?
  exitYear            String?
  studentStatus       StudentStatus               @default(ACTIVE)
  healthScore         Int?                        @default(75)
  pebsFiliere         PebsFiliere?
  photoUrl            String?
  lv2SubjectId        String?
  parents             ParentStudent[]
  lv2Subject          Subject?                    @relation("StudentLV2", fields: [lv2SubjectId], references: [id])
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subGroupAssignments StudentSubGroupAssignment[]
  alevelSubjects      StudentALevelSubject[]
  verifiableDocuments VerifiableDocument[]
  enrollments         InscriptionMinesec[]
  enrollmentsYearScoped Enrollment[]
  promotions          StudentPromotion[]
  paiementsMinesec    PaiementMinesec[]
  paiementsEtab       PaiementEtablissement[]
  examRegistrations   ExamRegistration[]
  pebsExamCandidates  PebsExamCandidate[]
  followUpActions     StudentFollowUpAction[]
  groupMemberships    StudentGroupMembership[]
  anonymatCodes       AnonymatCode[]
}

enum MatriculeSource {
  MANUAL
  EXCEL_IMPORT
  SCRAPE_AUTO
  SYNC_NIGHTLY
}

