// Configuration par établissement et par checkpoint : quelles pistes sont possibles, quelles
// matières comptent, et si le test psychotechnique est utilisé à ce checkpoint dans cet
// établissement précis (pas un indicateur de donnée manquante — un vrai réglage par école).
model OrientationCheckpointConfig {
  id                          String                    @id @default(cuid())
  schoolId                    String
  school                      School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type                        OrientationCheckpointType
  possibleTracks              Json // ex. ["A", "SES", "C"] ou ["C", "D", "TI"]
  relevantSubjects            Json // matières déterminantes et poids pour ce checkpoint
  psychotechnicalTestRequired Boolean                   @default(false)
  // Fenêtre d'orientation annuelle récurrente (ex. mars-mai) — mois/jour seulement, pas d'année
  // fixe puisqu'elle se répète chaque année scolaire.
  windowStartMonth            Int                       @default(3)
  windowStartDay              Int                       @default(1)
  windowEndMonth              Int                       @default(5)
  windowEndDay                Int                       @default(31)
  responseDeadlineDays        Int                       @default(15)
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@unique([schoolId, type])
}

// Aspirations déclarées par l'élève lui-même — indépendant de l'existence d'une FicheOrientation
// (l'élève peut la soumettre avant même qu'un dossier ne soit ouvert pour lui).
model StudentAspiration {
  id             String                    @id @default(cuid())
  studentId      String
  student        User                      @relation("studentAspirations", fields: [studentId], references: [id], onDelete: Cascade)
  schoolId       String
  checkpointType OrientationCheckpointType
  desiredTrack   String?
  careerInterest String?
  submittedAt    DateTime                  @default(now())

  @@unique([studentId, checkpointType])
  @@index([schoolId, checkpointType])
}

model FicheOrientation {
  id              String                 @id @default(cuid())
  studentId       String
  schoolId        String
  academicYearId  String
  conseillerId    String
  status          OrientationStatus      @default(OUVERTE)
  riskLevel       NiveauRisque           @default(FAIBLE)
  mainConcern     TypePreoccupation?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  student         User                   @relation("studentFiches", fields: [studentId], references: [id])
  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  conseillerStaff User                   @relation("conseillerFiches", fields: [conseillerId], references: [id])
  entretiens      EntretienOrientation[]
  tests           TestAptitude[]
  recommandation  RecommandationSerie?
  suivis          SuiviOrientation[]

  @@unique([studentId, academicYearId])
  @@index([schoolId, status])
  @@index([schoolId, riskLevel])
}

model EntretienOrientation {
  id                 String           @id @default(cuid())
  ficheOrientationId String
  date               DateTime
  type               TypeEntretien
  motif              MotifEntretien
  notes              String?
  recommendations    String?
  nextActions        String?
  parentNotified     Boolean          @default(false)
  followUpDate       DateTime?
  status             StatutEntretien  @default(PLANIFIE)
  createdAt          DateTime         @default(now())
  fiche              FicheOrientation @relation(fields: [ficheOrientationId], references: [id], onDelete: Cascade)

  @@index([ficheOrientationId])
}

model TestAptitude {
  id                 String                     @id @default(cuid())
  ficheOrientationId String
  type               TypeTest
  datePassage        DateTime
  resultats          String
  interpretation     String?
  scoreGlobal        Int?
  // Champs structurés du test psychotechnique de checkpoint (type=PSYCHOTECHNIQUE, moteur de
  // scoring) — null pour tout test manuel classique (COGNITIF/INTERETS_PROFESSIONNELS/PERSONNALITE).
  checkpointType     OrientationCheckpointType?
  scientificAptitude Int?
  literaryAptitude   Int?
  technicalAptitude  Int?
  administeredById   String?
  administeredBy     User?                      @relation("testAdministeredBy", fields: [administeredById], references: [id])
  createdAt          DateTime                   @default(now())
  fiche              FicheOrientation           @relation(fields: [ficheOrientationId], references: [id], onDelete: Cascade)

  @@index([ficheOrientationId])
  @@index([ficheOrientationId, checkpointType])
}

model RecommandationSerie {
  id                 String               @id @default(cuid())
  ficheOrientationId String               @unique
  studentId          String
  serieActuelle      String
  serieRecommandee   String
  justification      String
  parentNotified     Boolean              @default(false)
  adminValidated     Boolean              @default(false)
  status             StatutRecommandation @default(PROPOSEE)
  createdAt          DateTime             @default(now())
  fiche              FicheOrientation     @relation(fields: [ficheOrientationId], references: [id], onDelete: Cascade)

  // ── Champs du moteur de checkpoints (null pour une recommandation manuelle classique) ──
  checkpointType     OrientationCheckpointType?
  suggestedTracks    Json? // [{ track: "C", score: 82, justification: "..." }, ...]
  confidenceLevel    ConfidenceLevel?
  dataDepthMonths    Int?
  responseDeadline   DateTime?
  remindersSentAt    Json? // liste de timestamps des rappels déjà envoyés
  studentChosenTrack String?
  finalizedAt        DateTime?
  finalTrack         String? // piste réellement retenue — celle que le passage de classe utilise
}

model SuiviOrientation {
  id                 String            @id @default(cuid())
  ficheOrientationId String
  date               DateTime          @default(now())
  riskLevel          NiveauRisque
  mainConcern        TypePreoccupation
  interventions      String?
  prochainRdv        DateTime?
  notes              String?
  fiche              FicheOrientation  @relation(fields: [ficheOrientationId], references: [id], onDelete: Cascade)

  @@index([ficheOrientationId])
}

