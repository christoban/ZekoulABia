generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MasterUser {
  id                              String            @id @default(cuid())
  email                           String            @unique
  passwordHash                    String
  name                            String
  role                            MasterUserRole    @default(SUPPORT)
  assignedSchoolIds               String[]          @default([])
  isActive                        Boolean           @default(true)
  isSuperAdmin                    Boolean           @default(false)
  mfaEnabled                      Boolean           @default(false)
  mfaSecret                       String?
  mfaTempSecret                   String?
  mfaRecoveryCodeHashes           String[]          @default([])
  mfaRecoveryCodeGeneratedAt      DateTime?
  loginEmailOtpHash               String?
  loginEmailOtpExpiresAt          DateTime?
  loginEmailOtpAttempts           Int               @default(0)
  loginEmailOtpSentAt             DateTime?
  passwordChangeEmailOtpHash      String?
  passwordChangeEmailOtpExpiresAt DateTime?
  passwordChangeEmailOtpAttempts  Int               @default(0)
  passwordChangeEmailOtpSentAt    DateTime?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  auditLogs                       MasterAuthAudit[]
  schoolInvites                   SchoolInvite[]

  @@index([loginEmailOtpExpiresAt])
  @@index([passwordChangeEmailOtpExpiresAt])
}

// ─── Module Groupe Scolaire (Phase A — fondations) ─────────────────────────
// Voir Plan_Groupe_Scolaire_ZekoulABia.md section 1 : un SchoolGroupOwner n'est PAS un User
// d'école — il n'a pas de schoolId unique (il en supervise plusieurs), donc un compte
// entièrement séparé, sur le modèle de MasterUser, plutôt qu'une extension risquée de User/
// UserRole. Champs MFA/OTP dupliqués volontairement (cohérent avec l'authentification
// renforcée déjà exigée pour Admin/Staff/Enseignant — un compte à privilèges agrégés sur
// plusieurs écoles n'est pas moins sensible qu'un compte Admin).
model SchoolGroupOwner {
  id                         String       @id @default(cuid())
  email                      String       @unique
  passwordHash               String
  name                       String
  isActive                   Boolean      @default(true)
  mfaEnabled                 Boolean      @default(false)
  mfaSecret                  String?
  mfaTempSecret              String?
  mfaRecoveryCodeHashes      String[]     @default([])
  mfaRecoveryCodeGeneratedAt DateTime?
  loginEmailOtpHash          String?
  loginEmailOtpExpiresAt     DateTime?
  loginEmailOtpAttempts      Int          @default(0)
  loginEmailOtpSentAt        DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  group                      SchoolGroup?

  @@index([loginEmailOtpExpiresAt])
}

// planTier reste un texte libre pour l'instant (tarif négocié manuellement, "sur devis") —
// pas de moteur de facturation groupée automatisé dans ce premier jet (voir plan, Section 12).
model SchoolGroup {
  id        String           @id @default(cuid())
  name      String
  ownerId   String           @unique
  owner     SchoolGroupOwner @relation(fields: [ownerId], references: [id])
  schools   School[]
  planTier  String           @default("ETABLISSEMENT_PLUS")
  createdAt DateTime         @default(now())
}

// Transfert d'élève/enseignant entre deux écoles du même groupe — jamais une mutation directe
// de schoolId (casserait l'historique Grade/Attendance/Payment de l'ancien tenant). Deux étapes
// toujours : le Fondateur initie (PENDING_TARGET_ADMIN), l'Admin de l'école CIBLE valide.
// Voir Plan_Groupe_Scolaire_ZekoulABia.md Section 5. Champs volontairement sans relation Prisma
// (simples ids) — cette table n'est interrogée que par ces ids directement, jamais par jointure.
model GroupTransferRequest {
  id                 String              @id @default(cuid())
  groupId            String
  type               GroupTransferType
  sourceSchoolId     String
  targetSchoolId     String
  sourceUserId       String
  status             GroupTransferStatus @default(PENDING_TARGET_ADMIN)
  onboardingId       String?
  requestedByOwnerId String
  createdAt          DateTime            @default(now())
  decidedAt          DateTime?

  @@index([groupId])
  @@index([targetSchoolId, status])
}

enum GroupTransferType {
  STUDENT
  STAFF
}

enum GroupTransferStatus {
  PENDING_TARGET_ADMIN
  ACCEPTED
  REJECTED
}

model School {
  id                           String                        @id @default(cuid())
  name                         String
  subdomain                    String                        @unique
  type                         SchoolType                    @default(SECONDARY)
  plan                         PlanType                      @default(DISCOVERY)
  status                       SchoolStatus                  @default(PENDING)
  city                         String?
  region                       String?
  address                      String?
  phone                        String?
  email                        String?
  logoUrl                      String?
  // Code officiel MINESEC de l'établissement sur cartescolaire.cm (ex. "NO02140H27") — nécessaire
  // pour interroger la recherche publique de matricule (nom+établissement → matricule). Configuré
  // une fois par l'admin, pas deviné automatiquement (la liste des établissements y est trop longue
  // et instable pour un matching fiable).
  minesecSchoolCode            String?
  // Groupe scolaire multi-établissements (nullable — la quasi-totalité des écoles restent
  // des clients individuels hors groupe). Voir Plan_Groupe_Scolaire_ZekoulABia.md.
  groupId                      String?
  group                        SchoolGroup?                  @relation(fields: [groupId], references: [id])
  subsystem                    SchoolSubsystem               @default(FRANCOPHONE)
  educationType                EducationType                 @default(GENERAL)
  ownership                    SchoolOwnership               @default(PRIVATE_SECULAR)
  // Restriction d'admission par genre — pertinent surtout pour le technique (GGTC/CETIF
  // partagent exactement le programme GTC/CETIC, seule l'admission diffère). Proposé dans
  // l'onboarding uniquement pour educationType=TECHNICAL, jamais imposé ailleurs.
  admissionType                AdmissionType                 @default(MIXTE)
  features                     Json                          @default("{}")
  saturdaySchedule             Boolean                       @default(true)
  contractEnd                  DateTime?
  hasPEBSFrancophone           Boolean                       @default(false)
  hasPEBSAnglophone            Boolean                       @default(false)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  templateCode                 String?
  onboardingConfig             Json?
  sequences                    AcademicSequence[]
  academicYears                AcademicYear[]
  activitiesLogs               ActivitiesLog[]
  announcements                Announcement[]
  attendances                  Attendance[]
  classes                      Class[]
  classCouncilSessions         ClassCouncilSession[]
  bulletinValidationSessions   BulletinValidationSession[]
  classPromotions              ClassPromotion[]
  conversations                Conversation[]
  disciplineRecords            DisciplineRecord[]
  apeeTransactions             APEETransaction[]
  disciplineCouncilSessions    DisciplineCouncilSession[]
  emailLogs                    EmailLog[]
  exams                        Exam[]
  expenses                     Expense[]
  feePlans                     FeePlan[]
  grades                       Grade[]
  gradeFormulas                GradeFormula[]
  invoices                     Invoice[]
  mentionRules                 MentionRule[]
  notifications                Notification[]
  offlineQueue                 OfflineQueue[]
  payments                     Payment[]
  reportCards                  ReportCard[]
  template                     SchoolTemplate?               @relation(fields: [templateCode], references: [code])
  schoolConfig                 SchoolConfig?
  invites                      SchoolInvite[]
  schoolSettings               SchoolSettings?
  schoolNotificationSettings   SchoolNotificationSettings?
  configurationForm            SchoolConfigurationForm?
  staffAttendanceSettings      StaffAttendanceSettings?
  sections                     Section[]
  smsLogs                      SmsLog[]
  staffProfiles                StaffProfile[]
  studentPromotions            StudentPromotion[]
  subjects                     Subject[]
  departments                  Department[]
  subjectCoefficients          SubjectCoefficient[]
  classSubjectOverrides        ClassSubjectOverride[]
  timetables                   Timetable[]
  timetableGridConfig          TimetableGridConfig?
  rooms                        Room[]
  studentGroupSets             StudentGroupSet[]
  classRoomAssignments         ClassRoomAssignment[]
  users                        User[]
  submissions                  Submission[]
  books                        Book[]
  bookLoans                    BookLoan[]
  ficheOrientations            FicheOrientation[]
  orientationCheckpointConfigs OrientationCheckpointConfig[]
  studentRecommendations       StudentRecommendation[]
  teacherUnavailabilities      TeacherUnavailability[]
  academicEvents               AcademicEvent[]
  calendarExceptions           SchoolCalendarException[]
  verifiableDocuments          VerifiableDocument[]
  broadcastLogs                BroadcastLog[]
  programmes                   Programme[]
  cahierDeTexte                CahierDeTexte[]
  employeeFiles                EmployeeFile[]
  careerEvents                 CareerEvent[]
  staffAttendances             StaffAttendance[]
  leaveRequests                LeaveRequest[]
  leaveBalances                LeaveBalance[]
  missionOrders                MissionOrder[]
  enrollments                  InscriptionMinesec[]
  enrollmentsYearScoped        Enrollment[]
  studentOnboardings           StudentOnboarding[]
  schoolOnboardingSettings     SchoolOnboardingSettings?
  statisticalSubmissions       StatisticalSubmission[]
  statisticalSupplement        SchoolStatisticalSupplement?
  minedubSupplement            MinedubSchoolSupplement?
  minedubReports               MinedubStatisticalReport[]
  studentFollowUpActions       StudentFollowUpAction[]
  assessmentScopes             AssessmentScope[]
  assessmentSessions           HarmonizedAssessmentSession[]
  assessmentParticipations     AssessmentParticipation[]
  anonymatCodes                AnonymatCode[]
  notesAnonymes                NoteAnonyme[]
  anonymatTeamMembers          AnonymatTeamMember[]
  correctionAssignments        CorrectionAssignment[]
  tasks                        Task[]
}

model SchoolInvite {
  id                String       @id @default(cuid())
  email             String
  schoolName        String
  token             String       @unique @default(cuid())
  plan              PlanType     @default(DISCOVERY)
  status            InviteStatus @default(PENDING)
  expiresAt         DateTime
  createdAt         DateTime     @default(now())
  schoolId          String?
  invitedByMasterId String?
  notes             String?
  school            School?      @relation(fields: [schoolId], references: [id])
  invitedByMaster   MasterUser?  @relation(fields: [invitedByMasterId], references: [id])
}

model SchoolConfig {
  id                               String           @id @default(cuid())
  schoolId                         String           @unique
  ds1Weight                        Float            @default(1)
  ds2Weight                        Float            @default(1)
  compositionWeight                Float            @default(2)
  classTestWeight                  Float            @default(30)
  terminalExamWeight               Float            @default(70)
  moderatorUserId                  String?
  moderator                        User?            @relation("SchoolModerator", fields: [moderatorUserId], references: [id])
  aiRiskThreshold                  Int              @default(50)
  aiRiskThresholdCritical          Int              @default(30)
  subjectDropThreshold             Float            @default(3)
  bulletinTemplate                 BulletinTemplate @default(FR_SECONDARY)
  gradesPerTerm                    Int              @default(2)
  sequenceCalculationMode          String           @default("single")
  legalMaxContributionFirstCycle   Int              @default(7500)
  legalMaxContributionSecondCycle  Int              @default(10000)
  termsPerYear                     Int              @default(3)
  maxAbsences                      Int              @default(10)
  smsEnabled                       Boolean          @default(false)
  offlineModeEnabled               Boolean          @default(true)
  aiAlertsEnabled                  Boolean          @default(true)
  messageModeration                Boolean          @default(false)
  /// Échappatoire explicite et traçable : true par défaut (l'école a un vrai conseiller
  /// d'orientation dédié). Réglé à false uniquement si un établissement précis n'a
  /// effectivement personne dans ce rôle — jamais le comportement par défaut.
  hasDedicatedOrientationCounselor Boolean          @default(true)
  /// Redondant avec School.subsystem. Utilisé par l'API SchoolSettings (frontend + locale auto-dérivation).
  /// La résolution de langue RUNTIME utilise School.subsystem via resolveLanguage() — NE PAS utiliser pour la langue.
  schoolLanguageMode               String           @default("francophone")
  attendanceLateAsAbsence          Boolean          @default(false)
  bulletinBlockOnUnpaidFees        Boolean          @default(false)
  councilPassMark                  Float            @default(10)
  passMark                         Float            @default(10)
  passwordMinLength                Int              @default(8)
  passwordRequireUpper             Boolean          @default(false)
  passwordRequireDigit             Boolean          @default(true)
  sessionTimeoutMin                Int              @default(60)
  updatedAt                        DateTime         @updatedAt
  /// V2.2 — Registre des champs SchoolConfig personnalisés localement (non hérités du template).
  /// Tableau JSON de noms de champs (ex: ["passMark","smsEnabled"]). Jamais écrasé par une
  /// ré-application de template.
  configOverrides                  Json             @default("[]")
  absenceAlertThreshold            Int              @default(3)
  christmasBreakEnd                DateTime?
  christmasBreakStart              DateTime?
  easterBreakEnd                   DateTime?
  easterBreakStart                 DateTime?
  schoolYearStartDate              DateTime?
  yearEndDate                      DateTime?
  school                           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// Conseil IA personnalisé, généré et persisté par destinataire (Phase 4 du chantier
// "élève à risque") — distinct des recommandations éphémères de CalculerIndiceSanteUseCase.execute()
// (jamais sauvegardées, affichées une fois côté Admin). Alimente aussi les vues par rôle (Phase 5)
// et le déclenchement Orientation (Phase 7 : compter les HEALTH_CRITICAL consécutifs).
model StudentRecommendation {
  id            String   @id @default(cuid())
  schoolId      String
  studentId     String
  subjectId     String?
  recipientRole String // 'STUDENT' | 'PARENT' | 'TEACHER'
  contextType   String // 'HEALTH_CRITICAL' | 'HEALTH_WARNING' | 'HEALTH_POSITIVE' | 'SUBJECT_DROP'
  content       String   @db.Text
  createdAt     DateTime @default(now())

  school          School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         User                    @relation("StudentRecommendationTarget", fields: [studentId], references: [id], onDelete: Cascade)
  followUpActions StudentFollowUpAction[]

  @@index([schoolId, studentId])
  @@index([studentId, contextType, createdAt])
}

// Transforme une alerte de santé scolaire lue passivement en un suivi tracé, assigné et
// clôturable (PLAN_VERIFICATION_ET_ACTIONS_SUIVI.md, Partie B). Trois types d'action seulement
// pour cette première version — pas de workflow complexe tant que l'usage réel n'en montre pas
// le besoin.
model StudentFollowUpAction {
  id               String @id @default(cuid())
  schoolId         String
  studentProfileId String

  // Lien vers l'alerte qui a déclenché cette action, pour garder le contexte.
  triggeringRecommendationId String?

  // Renseigné uniquement quand l'auteur est un enseignant de matière (pas professeur principal) —
  // matérialise la restriction "sur sa propre matière uniquement" plutôt que de la déduire
  // implicitement de triggeringRecommendationId, qui n'existe pas toujours.
  subjectId String?

  type   StudentFollowUpActionType
  status StudentFollowUpStatus     @default(OUVERT)

  createdById  String
  assignedToId String? // ex. le conseiller pédagogique si type = SIGNALEMENT_CONSEILLER

  targetDate DateTime? // date cible pour l'entretien parent ou la convocation élève
  note       String?   @db.Text // texte libre (observation, ou détail de la demande)

  // ENTRETIEN_PARENT uniquement — choisi à la création, détermine le contenu de la notification
  // envoyée au parent (date déjà fixée à confirmer, ou demande de disponibilité en amont).
  interviewMode InterviewMode?

  createdAt   DateTime  @default(now())
  closedAt    DateTime?
  closedById  String?
  closingNote String?   @db.Text // obligatoire à la clôture (imposé au niveau use case, pas ici)

  school                   School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentProfile           StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  triggeringRecommendation StudentRecommendation? @relation(fields: [triggeringRecommendationId], references: [id])
  subject                  Subject?               @relation(fields: [subjectId], references: [id])
  createdBy                User                   @relation("FollowUpCreatedBy", fields: [createdById], references: [id])
  assignedTo               User?                  @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id])
  closedBy                 User?                  @relation("FollowUpClosedBy", fields: [closedById], references: [id])

  @@index([studentProfileId])
  @@index([schoolId, assignedToId, status])
}

enum StudentFollowUpActionType {
  ENTRETIEN_PARENT
  SIGNALEMENT_CONSEILLER
  OBSERVATION
  CONVOCATION_ELEVE
}

enum StudentFollowUpStatus {
  OUVERT
  EN_COURS
  CLOS
}

enum InterviewMode {
  DATE_PROPOSEE
  DEMANDE_DISPONIBILITE
}

// Fonctionnalités événementielles liées au calendrier académique (rentrée 6e/5e, migration
// post-examen bilingue, choix LV2...) — cycle de vie explicite au lieu d'être visibles en
// permanence sans raison. Trois catégories, trois mécanismes distincts (voir
// Plan_Evenements_Calendrier_ZekoulABia.md pour le raisonnement complet) :
//  - FIXED_DATE : date connue à l'avance, ouverture/fermeture automatiques par le job Inngest.
//  - MANUAL_TRIGGER : dépend d'un fait externe imprévisible (résultats d'examen) — jamais
//    automatique, l'admin déclenche lui-même via DeclencherEvenementUseCase.
//  - SLIDING_WINDOW : fenêtre par défaut automatique, mais date de clôture ajustable par l'admin,
//    et prolongée automatiquement si elle chevauche une période de vacances.
enum AcademicEventCategory {
  FIXED_DATE
  MANUAL_TRIGGER
  SLIDING_WINDOW
}

enum AcademicEventStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

model AcademicEvent {
  id               String                @id @default(cuid())
  schoolId         String
  type             String // 'RENTREE_6E_5E' | 'MIGRATION_BILINGUE' | 'CHOIX_LV2' | 'CLOTURE_ANNEE' | 'AUTRE'
  category         AcademicEventCategory
  title            String
  description      String?
  // Rôles concernés par la notification d'ouverture / le rappel — ex. ['PARENT','STUDENT'].
  targetRoles      String[]
  // Niveau concerné — utilisé uniquement quand type = 'CHOIX_LV2' (Lv2ChoiceWindow est scopée
  // par niveau, pas seulement par école). Null pour tous les autres types d'événement.
  level            String?
  openDate         DateTime? // null tant qu'un MANUAL_TRIGGER n'a pas été déclenché
  closeDate        DateTime?
  status           AcademicEventStatus   @default(UPCOMING)
  // Id de la ressource métier réelle ouverte par cet événement (ex. Lv2ChoiceWindow.id pour
  // CHOIX_LV2) — l'événement académique déclenche la fonctionnalité réelle, il n'est jamais un
  // simple rappel décoratif à côté d'elle. Null pour les types d'événement sans ressource liée.
  linkedResourceId String?
  triggeredById    String?
  triggeredAt      DateTime?
  // Empêche l'envoi répété du rappel de clôture à chaque passage du job quotidien.
  reminderSentAt   DateTime?
  createdById      String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  school      School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  triggeredBy User?  @relation("AcademicEventTriggeredBy", fields: [triggeredById], references: [id])
  createdBy   User   @relation("AcademicEventCreatedBy", fields: [createdById], references: [id])

  @@index([schoolId, status])
}

// Exceptions locales au calendrier scolaire d'un établissement (fermeture exceptionnelle,
// journée culturelle/sportive) — s'ajoutent aux périodes académiques déjà définies
// (AcademicPeriod.startDate/endDate) plutôt que de redéfinir tout un calendrier national :
// les intervalles ENTRE deux périodes sont déjà, par construction, des vacances scolaires.
model SchoolCalendarException {
  id        String   @id @default(cuid())
  schoolId  String
  date      DateTime
  label     String
  type      String // 'FERMETURE' | 'JOURNEE_SPECIALE'
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
  @@index([schoolId])
}

model SchoolSettings {
  id               String    @id @default(cuid())
  schoolId         String    @unique
  timezone         String    @default("Africa/Douala")
  /// Locale régionale pour le formatage (dates, nombres, monnaie). Ne détermine PAS la langue d'affichage.
  /// La langue d'affichage est résolue par resolveLanguage(subsystem, sectionCode).
  locale           String    @default("fr-CM")
  currency         String    @default("XAF")
  lastBackupAt     DateTime?
  lastBackupFile   String?
  logRetentionDays Int       @default(90)
  updatedAt        DateTime  @updatedAt
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolNotificationSettings {
  id               String  @id @default(cuid())
  schoolId         String  @unique
  smsAbsences      Boolean @default(true)
  smsPayments      Boolean @default(true)
  smsBulletins     Boolean @default(true)
  emailDigestAdmin Boolean @default(false)
  smsLowBalance    Boolean @default(false)
  school           School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolConfigurationForm {
  id          String    @id @default(cuid())
  schoolId    String    @unique
  formData    Json      @default("{}")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model GradeFormula {
  id          String   @id @default(cuid())
  schoolId    String?
  sectionId   String?
  label       String
  evaluations Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  school      School?  @relation(fields: [schoolId], references: [id])
  section     Section? @relation(fields: [sectionId], references: [id])

  @@index([schoolId])
}

model MentionRule {
  id        String   @id @default(cuid())
  schoolId  String?
  sectionId String?
  rules     Json
  isDefault Boolean  @default(false)
  school    School?  @relation(fields: [schoolId], references: [id])
  section   Section? @relation(fields: [sectionId], references: [id])

  @@index([schoolId])
}

model User {
  id                              String                     @id @default(cuid())
  schoolId                        String
  role                            UserRole
  email                           String?
  phone                           String?
  passwordHash                    String?
  resetPasswordToken              String?                    @unique
  resetPasswordTokenExpiry        DateTime?
  // Authentification renforcée (ADMIN/STAFF/TEACHER : MFA obligatoire · PARENT/STUDENT : email seul).
  // Miroir exact des champs équivalents sur MasterUser (voir modèle ci-dessus) — même mécanique otplib.
  mfaEnabled                      Boolean                    @default(false)
  mfaSecret                       String?
  mfaTempSecret                   String?
  mfaRecoveryCodeHashes           String[]                   @default([])
  mfaRecoveryCodeGeneratedAt      DateTime?
  loginEmailOtpHash               String?
  loginEmailOtpExpiresAt          DateTime?
  loginEmailOtpAttempts           Int                        @default(0)
  loginEmailOtpSentAt             DateTime?
  firstName                       String
  lastName                        String
  avatarUrl                       String?
  isActive                        Boolean                    @default(true)
  mustChangePassword              Boolean                    @default(false)
  // Défaut FULL_ACCESS. SMS_ONLY : compte créé (grades/présence/etc. fonctionnent normalement)
  // mais aucun lien d'activation/notification n'est jamais envoyé — la seule famille n'a pas de
  // smartphone du tout (Axe 2, Plan_Diversite_Numerique). Orthogonal à recipientType, qui
  // détermine QUI reçoit le lien, pas COMMENT on le contacte ensuite.
  accessMode                      UserAccessMode             @default(FULL_ACCESS)
  refreshTokenVersion             Int                        @default(0)
  lastLogin                       DateTime?
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  // Suppression douce (Couche 1, PLAN_IMPLEMENTATION_BACKUP.md) — jamais de vrai DELETE sur un
  // compte utilisateur. null = actif. Filtré automatiquement sur toute lecture standard par
  // softDeleteExtension.ts ; un appelant qui a besoin de voir tous les statuts (corbeille, purge)
  // passe explicitement deletedAt dans son where pour contourner le filtre.
  // Limite connue et acceptée : @@unique([schoolId, email/phone]) ci-dessous reste global (actif
  // + corbeille confondus) — un email/téléphone d'un compte à la corbeille reste indisponible
  // pour un nouveau compte pendant les 30 jours de délai de grâce. Contournement si besoin réel :
  // purger l'ancien compte plus tôt depuis l'écran Corbeille plutôt qu'attendre.
  deletedAt                       DateTime?
  deletedById                     String?
  announcements                   Announcement[]             @relation("AnnouncementAuthor")
  conversationParticipants        ConversationParticipant[]
  attendancesRecorded             Attendance[]               @relation("RecordedAttendances")
  attendancesAsTeacher            Attendance[]               @relation("TeacherAttendances")
  attendancesAsStudent            Attendance[]               @relation("StudentAttendances")
  attendancesJustified            Attendance[]               @relation("JustifiedAttendances")
  councilDecisions                ClassCouncilDecision[]     @relation("CouncilDecisionStudent")
  councilPresided                 ClassCouncilSession[]      @relation("CouncilPresidedBy")
  bulletinSessionsSubmitted       BulletinValidationSession[] @relation("BulletinSessionSubmittedBy")
  bulletinSessionsValidated       BulletinValidationSession[] @relation("BulletinSessionValidatedBy")
  disciplineDecided               DisciplineRecord[]         @relation("DisciplineDecidedBy")
  disciplineRecords               DisciplineRecord[]         @relation("StudentDiscipline")
  expensesCreated                 Expense[]                  @relation("CreatedExpenses")
  gradesRecorded                  Grade[]                    @relation("RecordedGrades")
  gradesAsStudent                 Grade[]                    @relation("StudentGrades")
  gradesValidated                 Grade[]                    @relation("ValidatedGrades")
  invoices                        Invoice[]                  @relation("StudentInvoices")
  moderatedMessages               Message[]                  @relation("ModeratedMessages")
  moderatedSchoolConfigs          SchoolConfig[]             @relation("SchoolModerator")
  sentMessages                    Message[]                  @relation("SentMessages")
  receivedMessages                MessageReadStatus[]
