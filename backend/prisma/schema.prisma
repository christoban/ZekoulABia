model DisciplineRecord {
  id             String                    @id @default(cuid())
  schoolId       String
  studentId      String
  type           DisciplineType
  reason         String
  decidedById    String
  startDate      DateTime?
  endDate        DateTime?
  status         DisciplineStatus          @default(ACTIVE)
  createdAt      DateTime                  @default(now())
  school         School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  decidedBy      User                      @relation("DisciplineDecidedBy", fields: [decidedById], references: [id])
  student        User                      @relation("StudentDiscipline", fields: [studentId], references: [id])
  councilSession DisciplineCouncilSession?

  @@index([schoolId, studentId])
}

enum DisciplineCouncilStatus {
  CONVOQUE
  TENU
  ANNULE
}

/**
 * Conseil de Discipline conforme Art. 30 (Loi 9 de la carte) — convocation des parents
 * obligatoire minimum 72h avant la tenue, composition légale (chef d'établissement, censeur,
 * SG, PP, représentant parents, représentant élèves). Un DisciplineRecord de type
 * COUNCIL_DECISION ou PERMANENT_EXCLUSION ne peut être créé QUE via ce workflow (voir la
 * route POST /api/v2/discipline, qui refuse désormais ces deux types en création directe) —
 * chantier Juillet 2026.
 */
model DisciplineCouncilSession {
  id                 String                  @id @default(cuid())
  schoolId           String
  studentId          String
  presidedById       String
  motif              String
  // { chefEtablissement, censeur, sg, pp, representantParents, representantEleves } : String
  composition        Json
  parentNotifiedAt   DateTime                @default(now())
  scheduledAt        DateTime
  heldAt             DateTime?
  decision           DisciplineType?
  pv                 String?
  status             DisciplineCouncilStatus @default(CONVOQUE)
  disciplineRecordId String?                 @unique
  createdAt          DateTime                @default(now())

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student          User              @relation("DisciplineCouncilStudent", fields: [studentId], references: [id])
  presidedBy       User              @relation("DisciplineCouncilPresidedBy", fields: [presidedById], references: [id])
  disciplineRecord DisciplineRecord? @relation(fields: [disciplineRecordId], references: [id])

  @@index([schoolId, studentId])
}

