#!/usr/bin/env sh
# Garde-fou backend : tsc --noEmit (projet complet) + détection de `as any`/@ts-ignore/
# @ts-expect-error réintroduits, sur tout commit touchant backend/**/*.ts.
#
# N'utilise PAS `eslint --max-warnings 0` sur le fichier entier : la règle
# @typescript-eslint/no-explicit-any flague aussi bien les casts `as any` que les annotations
# `: any` (paramètres/variables) — et 306 annotations `: any` préexistantes traînent encore
# dans le code (hors périmètre du nettoyage `as any` déjà fait, 2026-08-10). Avec
# --max-warnings 0 sur le fichier entier, toucher un vieux fichier pour une raison sans
# rapport suffirait à bloquer le commit. On vérifie donc précisément ce qu'on veut empêcher —
# la RÉINTRODUCTION d'un cast/suppression de type — via les lignes AJOUTÉES du diff stagé,
# jamais la dette déjà présente ailleurs dans le fichier.
#
# Ne bloque PAS `as unknown as TypePrécis` : ce double-cast est un idiome légitime et déjà
# largement utilisé dans le code (JSON Prisma, enums) pour typer précisément une valeur sans
# `any` — seul `as any` lui-même (et @ts-ignore/@ts-expect-error) est un vrai garde-fou.

REPO_ROOT=$(pwd)

STAGED_BACKEND_TS=$(git diff --cached --name-only --diff-filter=ACMDR | grep -E '^backend/.*\.tsx?$' || true)
STAGED_FRONTEND_TS=$(git diff --cached --name-only --diff-filter=ACMDR | grep -E '^frontend/.*\.tsx?$' || true)

if [ -n "$STAGED_BACKEND_TS" ]; then
  echo "🔍 Pré-commit backend : tsc --noEmit + architectureGuard + détection as any/@ts-ignore réintroduits..."

  cd "$REPO_ROOT/backend" || exit 1

  echo "  → tsc --noEmit (projet complet)"
  ./node_modules/.bin/tsc --noEmit || {
    echo "❌ tsc backend a échoué. Corrigez les erreurs de type avant de committer."
    exit 1
  }

  echo "  → architectureGuard.test.ts (règles hexagonales & zéro any)"
  bun test tests/unit/architectureGuard.test.ts || {
    echo "❌ architectureGuard backend a échoué. Corrigez les violations avant de committer."
    exit 1
  }

  echo "  → recherche de as any / @ts-ignore / @ts-expect-error sur les lignes ajoutées"
  CULPRITS=$(git -C "$REPO_ROOT" diff --cached --no-ext-diff -M | awk '
    /^diff --git/ { inBackend = ($0 ~ / b\/backend\//) }
    inBackend && /^\+[^+]/ && !/^\+\s*(\*|\/\/)/ && ($0 ~ /\bas any\b/ || $0 ~ /@ts-ignore/ || $0 ~ /@ts-expect-error/) { print }
  ')

  if [ -n "$CULPRITS" ]; then
    echo "❌ Nouveau \`as any\` (ou @ts-ignore/@ts-expect-error) détecté dans les lignes ajoutées :"
    echo "$CULPRITS"
    echo "   Utilisez un type précis (voir CONVENTIONS.md) — \`as unknown as TypePrécis\` reste autorisé."
    exit 1
  fi

  echo "✅ Pré-commit backend OK"
fi

if [ -n "$STAGED_FRONTEND_TS" ]; then
  echo "🔍 Pré-commit frontend : tsc --noEmit + architectureGuard.test.ts..."

  cd "$REPO_ROOT/frontend" || exit 1

  echo "  → tsc --noEmit (projet complet)"
  ./node_modules/.bin/tsc --noEmit || {
    echo "❌ tsc frontend a échoué. Corrigez les erreurs de type avant de committer."
    exit 1
  }

  echo "  → architectureGuard.test.ts (zéro any, zéro alert/confirm, isolation shell/ui, cliquet 500 l.)"
  bun test src/tests/architectureGuard.test.ts || {
    echo "❌ architectureGuard frontend a échoué. Corrigez les violations avant de committer."
    exit 1
  }

  echo "✅ Pré-commit frontend OK"
fi
